{%- comment -%} Index de recherche d'une langue : entrées, écuries, voitures, termes du glossaire, jalons et contexte, dossiers. {%- endcomment -%}
{%- assign lang = page.lang | default: site.lang | default: "fr" -%}
{%- assign T = site.data.i18n[lang] -%}
{%- if lang == "en" -%}{%- assign D = site.data.en -%}{%- else -%}{%- assign D = site.data -%}{%- endif -%}
{%- assign sep = "" -%}
[
{%- for e in site[T.collection_entrees] -%}
{{ sep }}{"type":"entree","titre":{{ e.title | jsonify }},"sous":{{ e.accroche | jsonify }},"url":{{ e.url | relative_url | jsonify }},"texte":{{ e.content | strip_html | replace: "&amp;", "&" | normalize_whitespace | jsonify }}}
{%- assign sep = "," -%}
{%- endfor -%}
{%- for v in site[T.collection_voitures] -%}
{%- capture titre_v %}{{ v.title }} ({{ v.annee }}){% endcapture -%}
{{ sep }}{"type":"voiture","titre":{{ titre_v | jsonify }},"sous":{{ v.accroche | jsonify }},"url":{{ v.url | relative_url | jsonify }},"texte":{{ v.content | strip_html | replace: "&amp;", "&" | normalize_whitespace | jsonify }}}
{%- endfor -%}
{%- comment -%} écuries : nom, lignée et, s'il est publié, le passage depuis le nom précédent ; une écurie
présente dans plusieurs lignées (Lola, March) ou revenue dans la sienne (Renault) n'apparaît qu'une fois {%- endcomment -%}
{%- assign vus = "," -%}
{%- for l in D.ecuries.lignees -%}
{%- for s in l.segments -%}
{%- assign e = D.ecuries.ecuries | where: "id", s.ecurie | first -%}
{%- capture cle_vu %},{{ e.id }},{% endcapture -%}
{%- if vus contains cle_vu -%}{%- continue -%}{%- endif -%}
{%- assign vus = vus | append: e.id | append: "," -%}
{%- capture url_e %}{{ T.url.ecuries | relative_url }}{{ e.id }}/{% endcapture -%}
{%- capture titre_e %}{{ e.nom }} ({{ s.de }}{% if s.a != s.de %}–{{ s.a }}{% endif %}){% endcapture -%}
{{ sep }}{"type":"ecurie","titre":{{ titre_e | jsonify }},"sous":{{ l.nom | jsonify }},"url":{{ url_e | jsonify }},"texte":{{ s.lien.pourquoi | default: "" | jsonify }}}
{%- endfor -%}
{%- endfor -%}
{%- for t in D.glossaire -%}
{%- capture url_t %}{{ T.url.glossaire | relative_url }}#{{ t.id }}{% endcapture -%}
{%- capture texte_t %}{{ t.definition }} {{ t.premiere }}{% endcapture -%}
{{ sep }}{"type":"terme","titre":{{ t.terme | jsonify }},"sous":"","url":{{ url_t | jsonify }},"texte":{{ texte_t | jsonify }}}
{%- endfor -%}
{%- for j in D.chronologie.jalons -%}
{%- capture url_j %}{{ T.url.chronologie | relative_url }}#j-{{ j.id }}{% endcapture -%}
{%- capture titre_j %}{{ j.annee }} — {{ j.titre }}{% endcapture -%}
{{ sep }}{"type":"jalon","titre":{{ titre_j | jsonify }},"sous":"","url":{{ url_j | jsonify }},"texte":{{ j.texte | jsonify }}}
{%- endfor -%}
{%- comment -%} les événements de contexte de la frise sont classés avec les jalons (groupe « chronologie ») {%- endcomment -%}
{%- for c in D.chronologie.contexte -%}
{%- capture url_c %}{{ T.url.chronologie | relative_url }}#c-{{ c.id }}{% endcapture -%}
{%- capture titre_c %}{{ c.annee }} — {{ c.titre }}{% endcapture -%}
{{ sep }}{"type":"jalon","titre":{{ titre_c | jsonify }},"sous":"","url":{{ url_c | jsonify }},"texte":{{ c.texte | jsonify }}}
{%- endfor -%}
{%- comment -%} dossiers : la prose seule, sans les tableaux générés (Hégémonies) {%- endcomment -%}
{%- for d in site[T.collection_dossiers] -%}
{%- assign morceaux = d.content | split: '<div class="table-defil"' -%}
{%- capture prose -%}{%- for m in morceaux -%}{%- if forloop.first -%}{{ m }}{%- else -%}{{ m | split: "</table></div>" | last }}{%- endif -%}{%- endfor -%}{%- endcapture -%}
{{ sep }}{"type":"dossier","titre":{{ d.title | jsonify }},"sous":{{ d.resume | jsonify }},"url":{{ d.url | relative_url | jsonify }},"texte":{{ prose | strip_html | replace: "&amp;", "&" | normalize_whitespace | jsonify }}}
{%- endfor -%}
]
