#!/bin/sh
# Crochet Git « pre-push » versionné : lance outils/verifier.py et refuse le push si le contrôle
# échoue. Actif après un passage de outils/installer-crochet.sh (core.hooksPath -> outils/crochets).
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 -I outils/verifier.py || { echo "Push annulé : corriger les erreurs ci-dessus."; exit 1; }
